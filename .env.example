# OLMOA Platform Environment Configuration Template
# Copy this file to .env or configure in Cloudflare Secrets

# Cloudflare Account & Worker Settings
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# D1 Database Binding
D1_DATABASE_NAME=openmarket-db
D1_DATABASE_ID=6935e21b-ffdc-47d1-8e7d-d97b1b8b317a

# Security & Admin Secrets (Set via wrangler secret put)
ADMIN_SECRET=your_admin_secret_key_here
JWT_SECRET=your_jwt_signing_secret_here

# External Integrations
PRICESCANNER_API_KEY=your_pricescanner_integration_key_here

# Service URLs
VITE_API_BASE_URL=https://olmoa-api.dnjstjqppk.workers.dev
VITE_STOREFRONT_URL=https://openmarket.dnjstjqppk.workers.dev
VITE_PARTNER_URL=https://olmoa-partner.dnjstjqppk.workers.dev
VITE_ADMIN_URL=https://olmoa-admin.dnjstjqppk.workers.dev
