# OLMOA Platform Environment Configuration Template
# Workers secrets: set with `wrangler secret put <NAME>` (never commit real values).
# Local gateway dev: copy the Worker section to apps/cloudflare-gateway/.dev.vars (git-ignored).
# Frontend builds: VITE_* values are baked in at build time.

# ---------- Cloudflare Account & Deploy ----------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ---------- D1 Database Binding ----------
D1_DATABASE_NAME=openmarket-db
D1_DATABASE_ID=6935e21b-ffdc-47d1-8e7d-d97b1b8b317a

# ---------- Worker: core (wrangler secret put) ----------
# production | development. Sandbox payment simulator refuses to run in production.
ENVIRONMENT=production
# JWT signing secret, REQUIRED, >= 32 chars. Auth fails closed without it.
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
# Comma-separated browser origins allowed to call the API (no wildcard).
ALLOWED_ORIGINS=https://openmarket.dnjstjqppk.workers.dev,https://olmoa-storefront.dnjstjqppk.workers.dev,https://olmoa-partner.dnjstjqppk.workers.dev,https://olmoa-admin.dnjstjqppk.workers.dev
# Canonical storefront base URL used in sitemap.xml and deep links.
PUBLIC_STOREFRONT_URL=https://olmoa.com
# Optional build stamp surfaced by /api/version.
GIT_COMMIT=unset

# ---------- Worker: admin hardening ----------
# Comma-separated IPs/CIDRs allowed for admin access ("203.0.113.7, 198.51.100.0/24"). Empty = no restriction.
ADMIN_IP_ALLOWLIST=
# true|false. Production always requires admin 2FA even when set to false.
ADMIN_2FA_REQUIRED=true
# Optional dedicated key for sealing TOTP secrets (falls back to a JWT_SECRET derivation).
TOTP_ENCRYPTION_KEY=

# ---------- Worker: rate limiting ----------
# true = fail closed (503) when Workers Rate Limit bindings are missing; false = in-code fallback.
RATE_LIMIT_REQUIRED=true

# ---------- Worker: payments (Toss Payments) ----------
# live | sandbox. sandbox is refused in production; live requires TOSS_SECRET_KEY.
PAYMENT_MODE=live
TOSS_SECRET_KEY=test_sk_...
TOSS_CLIENT_KEY=test_ck_...
# Shared secret for sandbox PG webhooks (X-Webhook-Secret), >= 24 chars.
PAYMENT_WEBHOOK_SECRET=

# ---------- Worker: logistics & messaging ----------
# Shared secret for carrier webhooks (X-Carrier-Webhook-Secret), >= 24 chars.
CARRIER_WEBHOOK_SECRET=
# SOLAPI (SMS/AlimTalk) credentials for POST /api/v1/notifications/dispatch.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=15880000

# ---------- Worker: email (Resend, https://resend.com) ----------
# Enables reset + verification mails. EMAIL_FROM must be a sender domain verified in Resend (DNS).
RESEND_API_KEY=
EMAIL_FROM=noreply@olmoa.com

# ---------- Worker: social login (Kakao OAuth) ----------
# Without these, /api/v1/auth/social/kakao/* answers 501 and the login page says so.
# Register KAKAO_REDIRECT_URI exactly in the Kakao developers console (Redirect URI),
# enable the account_email consent item, and set the client secret if the app uses one.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://olmoa-api.dnjstjqppk.workers.dev/api/v1/auth/social/kakao/callback

# ---------- Worker: integrations & ops ----------
# PriceScanner feed key (X-Integration-Key). Requests without it are rejected.
PRICESCANNER_API_KEY=
# true enables the connector simulator, but NEVER in production (501 CONNECTOR_NOT_INTEGRATED).
CONNECTOR_SIMULATION=false
# Finance auto-reconciliation interval in minutes.
RECONCILE_INTERVAL_MINUTES=60
# Webhook (Slack/Discord/Teams incoming webhook URL) pinged when a reconciliation check fails.
ALERT_WEBHOOK_URL=
# Return window in days (also a wrangler var default).
RETURN_WINDOW_DAYS=7

# ---------- Frontend builds (VITE_*) ----------
VITE_API_BASE_URL=https://olmoa-api.dnjstjqppk.workers.dev
VITE_STOREFRONT_URL=https://openmarket.dnjstjqppk.workers.dev
VITE_PARTNER_URL=https://olmoa-partner.dnjstjqppk.workers.dev
VITE_ADMIN_URL=https://olmoa-admin.dnjstjqppk.workers.dev
