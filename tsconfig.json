{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.d.ts",
    "apps/*/src/**/*.vue"
  ]
}

