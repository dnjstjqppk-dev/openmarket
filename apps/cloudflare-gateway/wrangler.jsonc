{
  "name": "olmoa-api",
  // Domain account (owns the olmoa.com zone). Moved 2026-11-25 from the workers
  // account 6d53e0a853ad74dec5fefcd4b4600e3a — see reports/DOMAIN_CUTOVER_RUNBOOK.md.
  "account_id": "f5c363135efe9b22ca66eb39f2f8e1da",
  "main": "src/index.js",
  "compatibility_date": "2024-04-03",
  "workers_dev": false,
  "routes": [{ "pattern": "api.olmoa.com", "custom_domain": true, "zone_name": "olmoa.com" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmarket-db",
      "database_id": "6e23f7cd-7999-4419-ac6e-63481edc5454"
    }
  ],
  // NEW-06: media/KYB object storage. Ops must create the bucket
  // (`wrangler r2 bucket create olmoa-media`) before deploy; without it the
  // API honestly caps uploads at 1MB via the D1-embedded fallback.
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "olmoa-media"
    }
  ],
  // Non-secret defaults. Production stays fail-closed until secrets are set with `wrangler secret put`:
  //   JWT_SECRET (>=32 chars), ALLOWED_ORIGINS, PAYMENT_MODE=live + TOSS_SECRET_KEY/TOSS_CLIENT_KEY,
  //   CARRIER_WEBHOOK_SECRET, (optional) SOLAPI_API_KEY/SOLAPI_API_SECRET, PRICESCANNER_API_KEY,
  //   (optional) UNIPASS_API_KEY for customs PCCC verification (FORMAT_ONLY without it).
  //   Phase 2 channels: SMARTSTORE_CLIENT_ID/SMARTSTORE_CLIENT_SECRET, COUPANG_ACCESS_KEY/COUPANG_SECRET_KEY/COUPANG_VENDOR_ID.
  // Local development overrides these through apps/cloudflare-gateway/.dev.vars (git-ignored).
  "vars": {
    "ENVIRONMENT": "production",
    "RETURN_WINDOW_DAYS": "7"
  },
  // O12: Workers Rate Limiting (per Cloudflare location, approximate). namespace_id is an account-unique integer string.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_LOGIN", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } }
  ],
  // Releases expired unpaid orders (stock/coupon/credit) and auto-confirms deliveries older than 7 days.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
